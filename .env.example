# Claude API key (https://console.anthropic.com). Required for plan reading and ROM generation.
ANTHROPIC_API_KEY=

# Optional. Leave blank to use the built-in local database (stored in ./data/pglite).
# For hosting (e.g. Vercel), point this at a Postgres database (Neon, Supabase, Vercel Postgres).
DATABASE_URL=

# File storage for plans and proposal images. Leave all blank to use ./data/uploads locally.
# Supabase (preferred): the Vercel Supabase integration sets these automatically.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Or Vercel Blob:
BLOB_READ_WRITE_TOKEN=

# Team password for the whole app (required on Vercel). Client proposal links stay open.
APP_PASSWORD=

# Optional model override. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
