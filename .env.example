# Claude API key (https://console.anthropic.com). Required for plan reading and ROM generation.
ANTHROPIC_API_KEY=

# Optional. Leave blank to use the built-in local database (stored in ./data/pglite).
# For hosting (e.g. Vercel), point this at a Postgres database (Neon, Supabase, Vercel Postgres).
DATABASE_URL=

# Optional. Leave blank to store uploaded plans in ./data/uploads.
# For hosting on Vercel, create a Blob store and paste its token here.
BLOB_READ_WRITE_TOKEN=

# Optional model override. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
